{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Complexity Metrics report",
  "type": "object",
  "$defs": {
    "sourceLocation": {
      "type": "string",
      "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:[1-9][0-9]*:[1-9][0-9]*:[0-9]+(?![\\s\\S])"
    },
    "fanOutDetails": {
      "type": "object",
      "properties": {
        "unresolved_count": {"type": "integer", "minimum": 0},
        "unresolved_calls": {
          "type": "array",
          "description": "Unresolved outgoing calls with their source positions and resolution reasons.",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "description": "Call position as file:line:column in UTF-16 units.",
                "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:[1-9][0-9]*:[1-9][0-9]*(?![\\s\\S])"
              },
              "call": {"type": ["string", "null"]},
              "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            },
            "required": ["location", "call", "reasons"],
            "additionalProperties": false
          }
        }
      },
      "required": ["unresolved_count", "unresolved_calls"],
      "additionalProperties": false
    }
  },
  "properties": {
    "version": {
      "const": "20261122.0.0"
    },
    "summary": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "functions_found": {
          "type": "integer",
          "minimum": 0
        },
        "functions_presented": {
          "type": "integer",
          "minimum": 0
        },
        "function_discovery_complete": {
          "type": "boolean"
        },
        "has_errors": {
          "type": "boolean"
        }
      },
      "required": [
        "files",
        "functions_found",
        "functions_presented",
        "function_discovery_complete",
        "has_errors"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "pattern": "^(?:[A-Za-z]:(?:/|\\\\\\\\)|/|\\\\\\\\\\\\\\\\)(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))*(?![\\s\\S])",
            "description": "Absolute input path with presentation-encoded backslashes."
          },
          "analyzed": {
            "type": "boolean"
          },
          "functionDiscoveryComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "fileId",
          "analyzed",
          "functionDiscoveryComplete"
        ],
        "additionalProperties": false
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {"$ref": "#/$defs/sourceLocation"},
          "metrics": {
            "type": "object",
            "properties": {
              "cognitive_complexity": {
                "type": "integer",
                "minimum": 0
              },
              "halstead_volume": {
                "type": "number",
                "minimum": 0
              },
              "fan_in": {
                "type": "integer",
                "minimum": 0,
                "description": "Distinct confirmed functions that call this outer."
              },
              "fan_out": {
                "type": "integer",
                "minimum": 0,
                "description": "Distinct call destinations of this outer and its nested functions. Includes written paths when the target definition cannot be resolved."
              },
              "instability": {
                "anyOf": [
                  {"type": "number", "minimum": 0, "maximum": 1},
                  {"const": "NaN"}
                ],
                "description": "Fan-Out divided by Fan-In plus Fan-Out. The string NaN when both counts are zero."
              }
            },
            "required": [
              "cognitive_complexity",
              "halstead_volume",
              "fan_in",
              "fan_out",
              "instability"
            ],
            "additionalProperties": false
          },
          "halstead_counts": {
            "type": "object",
            "properties": {
              "n1": {
                "type": "integer",
                "minimum": 0,
                "description": "Total operator occurrences."
              },
              "n2": {
                "type": "integer",
                "minimum": 0,
                "description": "Total operand occurrences."
              },
              "eta1": {
                "type": "integer",
                "minimum": 0,
                "description": "Distinct operator keys."
              },
              "eta2": {
                "type": "integer",
                "minimum": 0,
                "description": "Distinct operand keys."
              }
            },
            "required": [
              "n1",
              "n2",
              "eta1",
              "eta2"
            ],
            "additionalProperties": false
          },
          "call_graph": {
            "type": "object",
            "properties": {
              "fan_in": {
                "type": "object",
                "properties": {
                  "callers_count": {"type": "integer", "minimum": 0},
                  "callers": {
                    "type": "array",
                    "description": "One entry per distinct confirmed caller. The location identifies its first call site.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"},
                        "location": {"$ref": "#/$defs/sourceLocation"}
                      },
                      "required": ["name", "location"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["callers_count", "callers"],
                "additionalProperties": false
              },
              "fan_out": {"$ref": "#/$defs/fanOutDetails"}
            },
            "required": ["fan_in", "fan_out"],
            "additionalProperties": false
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "location",
          "metrics",
          "halstead_counts",
          "call_graph",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": "string",
            "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:(?:[1-9][0-9]*:[1-9][0-9]*:[0-9]+|0:0:(?:[0-9]+|null))(?![\\s\\S])"
          }
        },
        "required": [
          "error",
          "name",
          "location"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": {
              "location": {
                "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:[1-9][0-9]*:[1-9][0-9]*:[0-9]+(?![\\s\\S])"
              }
            }
          },
          {
            "properties": {
              "name": {
                "type": "null"
              },
              "location": {
                "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:0:0:(?:[0-9]+|null)(?![\\s\\S])"
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "summary",
    "files",
    "functions",
    "diagnostics"
  ],
  "additionalProperties": false
}
