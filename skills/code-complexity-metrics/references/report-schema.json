{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Complexity Metrics report",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "functions_found": {
          "type": "integer",
          "minimum": 0
        },
        "functions_presented": {
          "type": "integer",
          "minimum": 0
        },
        "function_discovery_complete": {
          "type": "boolean"
        },
        "has_errors": {
          "type": "boolean"
        }
      },
      "required": [
        "files",
        "functions_found",
        "functions_presented",
        "function_discovery_complete",
        "has_errors"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "pattern": "^(?:[A-Za-z]:(?:/|\\\\\\\\)|/|\\\\\\\\\\\\\\\\)(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))*(?![\\s\\S])",
            "description": "Absolute input path with presentation-encoded backslashes."
          },
          "analyzed": {
            "type": "boolean"
          },
          "functionDiscoveryComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "fileId",
          "analyzed",
          "functionDiscoveryComplete"
        ],
        "additionalProperties": false
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": "string",
            "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:[1-9][0-9]*:[1-9][0-9]*:[0-9]+(?![\\s\\S])"
          },
          "metrics": {
            "type": "object",
            "properties": {
              "cognitive_complexity": {
                "type": "integer",
                "minimum": 0
              },
              "cyclomatic_complexity": {
                "type": "integer",
                "minimum": 0
              },
              "statement_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "cognitive_complexity",
              "cyclomatic_complexity",
              "statement_count"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "location",
          "metrics",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": "string",
            "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:(?:[1-9][0-9]*:[1-9][0-9]*:[0-9]+|0:0:(?:[0-9]+|null))(?![\\s\\S])"
          }
        },
        "required": [
          "error",
          "name",
          "location"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": {
              "location": {
                "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:[1-9][0-9]*:[1-9][0-9]*:[0-9]+(?![\\s\\S])"
              }
            }
          },
          {
            "properties": {
              "name": {
                "type": "null"
              },
              "location": {
                "pattern": "^(?:[^\\\\\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]|\\\\\\\\|\\\\[rnt]|\\\\u(?:00(?:0[0-8BCEF]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F])|202[89]))+:0:0:(?:[0-9]+|null)(?![\\s\\S])"
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "summary",
    "files",
    "functions",
    "diagnostics"
  ],
  "additionalProperties": false
}
